// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["stride"]
}

// ------------------------------------------------------
// 1. GLOBAL IDENTITY (Platform Level)
// ------------------------------------------------------


model User {
  id         String  @id @default(uuid())
  keycloakId String? @unique // Maps to the JWT 'sub' claim from Keycloak
  email      String  @unique
  phone      String? @unique // Crucial for SL market (SMS OTP via Text.lk)
  firstName  String
  lastName   String

  isGlobalAdmin Boolean @default(false)
  isActive      Boolean @default(true)

  memberships Membership[]
  auditLogs   AuditLog[] // Tracks actions performed by this user globally

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
  @@schema("stride")
}

// ------------------------------------------------------
// 2. TENANCY (B2B Configuration)
// ------------------------------------------------------

model Tenant {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  domain String? @unique

  // B2B Configs (JSONB allows flexible structures)
  themeConfig Json? // CSS variables, logo URLs
  taxRules    Json? // VAT, SSCL percentages
  gatewayKeys Json? // Encrypted PayHere/DirectPay Merchant IDs

  // Domain Relations (The Horizontal Isolation boundary)
  memberships Membership[]
  attendances Attendance[]
  invoices    Invoice[]
  resources   Resource[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
  @@schema("stride")
}

// ------------------------------------------------------
// 3. MEMBERSHIP & RBAC (The Intersection)
// ------------------------------------------------------

model Membership {
  id       String           @id @default(uuid())
  userId   String
  tenantId String
  status   MembershipStatus @default(ACTIVE)
  rfidTag  String?          @unique // <-- Add this to link physical hardware to the member

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles MembershipRole[]

  // Domain Relations (The Vertical Isolation boundary)
  attendances Attendance[]
  invoices    Invoice[]
  bookings    Booking[]
  metrics     Metric[]
  documents   Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@map("memberships")
  @@schema("stride")
}

model MembershipRole {
  id           String @id @default(uuid())
  membershipId String
  role         Role

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("membership_roles")
  @@schema("stride")
}

// ------------------------------------------------------
// 4. ATTENDANCE & INGRESS
// ------------------------------------------------------

model Attendance {
  id           String  @id @default(uuid())
  tenantId     String
  membershipId String? // Nullable in case of raw RFID scans before user linking
  rfidTag      String?
  authMethod   String // e.g., 'RFID', 'QR', 'MANUAL'

  checkInTime  DateTime  @default(now())
  checkOutTime DateTime? // For duration calculations

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("attendances")
  @@schema("stride")
}

// ------------------------------------------------------
// 5. BILLING & LEDGER
// ------------------------------------------------------

model Invoice {
  id           String @id @default(uuid())
  tenantId     String
  membershipId String

  type   InvoiceType // SUBSCRIPTION or TOKEN
  status InvoiceStatus @default(DRAFT)

  totalAmount Decimal   @db.Decimal(10, 2) // Always use Decimal for LKR
  dueDate     DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  payments Payment[]
  items    InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
  @@schema("stride")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
  @@schema("stride")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod // CASH, BANK_TRANSFER, PAYHERE
  gatewayTxId String?       @unique // ID from PayHere/DirectPay
  status      PaymentStatus @default(PENDING)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  processedAt DateTime @default(now())

  @@map("payments")
  @@schema("stride")
}

// ------------------------------------------------------
// 6. RESOURCES & SCHEDULING
// ------------------------------------------------------

model Resource {
  id             String       @id @default(uuid())
  tenantId       String
  name           String
  type           ResourceType // PHYSICAL or HUMAN
  capacity       Int          @default(1)
  linkedMemberId String? // For Trainer scheduling

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("resources")
  @@schema("stride")
}

model Booking {
  id           String @id @default(uuid())
  resourceId   String
  membershipId String

  startTime DateTime
  endTime   DateTime

  resource   Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("bookings")
  @@schema("stride")
}

// ------------------------------------------------------
// 7. EXTENSIBLE METRICS & HEALTH
// ------------------------------------------------------

model Metric {
  id           String @id @default(uuid())
  membershipId String

  metricType String // e.g., 'WEIGHT', 'ARCHERY_SCORE', 'STEPS'
  data       Json // The flexible payload

  recordedAt DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("metrics")
  @@schema("stride")
}

// ------------------------------------------------------
// 8. STORAGE & DOCUMENTS
// ------------------------------------------------------

model Document {
  id           String @id @default(uuid())
  membershipId String

  fileName String
  fileUrl  String // S3 bucket path
  context  String // e.g., 'WAIVER', 'AVATAR', 'MEDICAL'

  uploadedAt DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("documents")
  @@schema("stride")
}

// ------------------------------------------------------
// 9. AUDITING (Immutable Logs)
// ------------------------------------------------------

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String
  userId   String? // The Global User who performed the action

  action   String // e.g., 'MEMBER_STATUS_CHANGED', 'INVOICE_PAID'
  entity   String // The table affected
  entityId String // The ID of the affected record
  changes  Json? // Diff of what changed

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@schema("stride")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  ORG_ADMIN
  MANAGER
  TRAINER
  MEMBER
  @@schema("stride")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  @@schema("stride")
}

enum InvoiceType {
  SUBSCRIPTION
  TOKEN
  @@schema("stride")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  @@schema("stride")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PAYHERE
  DIRECTPAY
  @@schema("stride")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  @@schema("stride")
}

enum ResourceType {
  PHYSICAL
  HUMAN
  @@schema("stride")
}
