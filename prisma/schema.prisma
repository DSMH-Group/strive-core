generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas = ["auth", "stride"]
}

model User {
  id            String   @id @default(uuid())
  keycloakId    String?  @unique
  email         String   @unique
  phone         String?  @unique
  firstName     String
  lastName      String
  isGlobalAdmin Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auditLogs     AuditLog[]
  memberships   Membership[]

  @@map("users")
  @@schema("stride")
}

model Tenant {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  domain              String?             @unique
  themeConfig         Json?
  taxRules            Json?
  gatewayKeys         Json?
  businessRules       Json? // 🚀 NEW: e.g., { "allowTokenTopUps": true, "defaultCurrency": "LKR" }
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenantInvitations   TenantInvitation[]
  attendances         Attendance[]
  auditLogs           AuditLog[]
  invoices            Invoice[]
  memberships         Membership[]
  resources           Resource[]
  plans               Plan[] // 🚀 NEW: Relation to the tenant's product catalog
  savedPaymentMethods SavedPaymentMethod[]
  devices             Device[]
  sessionTemplates    SessionTemplate[]
  programTemplates    ProgramTemplate[]
  mailingLists        MailingList[]

  @@map("tenants")
  @@schema("stride")
}

// 🚀 NEW: The Product Catalog (Membership Tiers)
model Plan {
  id            String   @id @default(uuid())
  tenantId      String
  name          String // e.g., "Standard"
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  sessionTokens Int      @default(0) // Tokens granted per renewal
  allocationCap Int? // Optional hard cap on token accumulation
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations TenantInvitation[] // 🚀 NEW: Reciprocal relation

  @@map("plans")
  @@schema("stride")
}

model Membership {
  id       String           @id @default(uuid())
  userId   String
  tenantId String
  status   MembershipStatus @default(ACTIVE)
  rfidTag  String?          @unique

  // 🚀 NEW: Token Wallet & Subscription Engine Fields
  tokensLeft       Int       @default(0)
  activePlanId     String?
  autoRenewEnabled Boolean   @default(true)
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  bookings    Booking[]
  documents   Document[]
  invoices    Invoice[]
  roles       MembershipRole[]
  metrics     Metric[]
  activeProgram ProgramAssignment?

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePlan          Plan?               @relation(fields: [activePlanId], references: [id], onDelete: SetNull) // 🚀 NEW: Link to Plan
  savedPaymentMethods SavedPaymentMethod[]
  credentials         Credential[]
  mailingListMembers  MailingListMember[]

  @@unique([userId, tenantId])
  @@map("memberships")
  @@schema("stride")
}

model ProgramAssignment {
  id            String     @id @default(uuid())
  membershipId  String     @unique
  name          String
  goal          String
  currentWeek   Int        @default(1)
  totalWeeks    Int        @default(12)
  routines      Json       // Array of daily routine templates
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("program_assignments")
  @@schema("stride")
}

model MembershipRole {
  id         String     @id @default(uuid())
  membershipId String
  role         Role
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("membership_roles")
  @@schema("stride")
}

model Attendance {
  id           String      @id @default(uuid())
  tenantId     String
  membershipId String?
  rfidTag      String?
  authMethod   String
  checkInTime  DateTime    @default(now())
  checkOutTime DateTime?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendances")
  @@schema("stride")
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId     String
  membershipId String
  type        InvoiceType
  status      InvoiceStatus @default(DRAFT)
  totalAmount Decimal       @db.Decimal(10, 2)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  membership  Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@map("invoices")
  @@schema("stride")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
  @@schema("stride")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  gatewayTxId String?       @unique
  status      PaymentStatus @default(PENDING)
  processedAt DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@schema("stride")
}

model Resource {
  id             String       @id @default(uuid())
  tenantId       String
  name           String
  type           ResourceType
  capacity       Int          @default(1)
  linkedMemberId String?
  bookings       Booking[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("resources")
  @@schema("stride")
}

model Booking {
  id         String     @id @default(uuid())
  resourceId   String
  membershipId String
  startTime  DateTime
  endTime    DateTime
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  resource   Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("bookings")
  @@schema("stride")
}

model Metric {
  id         String     @id @default(uuid())
  membershipId String
  metricType String
  data       Json
  recordedAt DateTime   @default(now())
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("metrics")
  @@schema("stride")
}

model Document {
  id         String     @id @default(uuid())
  membershipId String
  fileName   String
  fileUrl    String
  context    String
  uploadedAt DateTime   @default(now())
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("documents")
  @@schema("stride")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("stride")
}

model TenantInvitation {
  id        String           @id @default(uuid())
  tenantId  String
  email     String?
  phone     String?
  role      Role
  status    InvitationStatus @default(PENDING)
  planId    String? // 🚀 NEW: Store the admin's selected plan
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan?  @relation(fields: [planId], references: [id], onDelete: SetNull) // 🚀 NEW: Relation

  @@index([email])
  @@index([phone])
  @@map("tenant_invitations")
  @@schema("stride")
}

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique(map: "user_email_unique")
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  keycloak_id   String?
  accounts      AuthAccount[]
  sessions      AuthSession[]

  @@map("user")
  @@schema("auth")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  token     String   @unique(map: "session_token_unique")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_id_user_id_fk")

  @@index([userId])
  @@map("session")
  @@schema("auth")
}

model AuthAccount {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@index([userId])
  @@map("account")
  @@schema("auth")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([identifier])
  @@map("verification")
  @@schema("auth")
}

enum Role {
  ORG_ADMIN
  MANAGER
  TRAINER
  MEMBER

  @@schema("stride")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  REVOKED

  @@schema("stride")
}

enum InvoiceType {
  SUBSCRIPTION
  TOKEN

  @@schema("stride")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID

  @@schema("stride")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PAYHERE
  DIRECTPAY

  @@schema("stride")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED

  @@schema("stride")
}

enum ResourceType {
  PHYSICAL
  HUMAN

  @@schema("stride")
}

enum InvitationStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED

  @@schema("stride")
}

model SavedPaymentMethod {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  payhereToken String // The secret customer_token from PayHere
  mask         String // e.g., "4242"
  brand        String // e.g., "VISA"
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])

  @@schema("stride")
}

model Device {
  id          String   @id @default(uuid())
  name        String
  token       String   @unique
  tenantId    String
  location    String
  direction   InOut    @default(IN)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("devices")
  @@schema("stride")
}

model Credential {
  id           String         @id @default(uuid())
  type         CredentialType
  tokenValue   String         @unique
  membershipId String
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@map("credentials")
  @@schema("stride")
}

enum InOut {
  IN
  OUT

  @@schema("stride")
}

enum Status {
  ACTIVE
  INACTIVE

  @@schema("stride")
}

enum CredentialType {
  RFID
  QR
  NFC_SMART_TAP
  FINGERPRINT

  @@schema("stride")
}

model SessionTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  exercises Json     // [{ name: "Bench Press", sets: 4 }, ...]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("session_templates")
  @@schema("stride")
}

model Exercise {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String   // e.g. "Strength", "Archery", "Cardio", "Mobility"
  bodyPart     String?  // e.g. "Chest", "Back", "Full Body"
  description  String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("exercises")
  @@schema("stride")
}

model ProgramTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  goal        String
  totalWeeks  Int      @default(12)
  routines    Json     // Array of routines with exercises
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("program_templates")
  @@schema("stride")
}

model MailingList {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     MailingListMember[]
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("mailing_lists")
  @@schema("stride")
}

model MailingListMember {
  id            String   @id @default(uuid())
  mailingListId String
  membershipId  String
  createdAt     DateTime @default(now())

  mailingList   MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)
  membership    Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([mailingListId, membershipId])
  @@map("mailing_list_members")
  @@schema("stride")
}
